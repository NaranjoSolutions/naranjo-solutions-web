---
import type { CollectionEntry } from 'astro:content';
import CaseStudy from '../../../components/CaseStudy.astro';
import { getLocalizedProjects } from '../../../content/projects';

export async function getStaticPaths() {
  const projects = await getLocalizedProjects('es');
  return projects.map((project) => ({
    params: { id: project.data.projectId },
    props: { project },
  }));
}

interface Props { project: CollectionEntry<'work'>; }
const { project } = Astro.props;
---

<CaseStudy project={project} />
