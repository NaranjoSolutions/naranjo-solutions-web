---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import ClinicOverview from '../components/ClinicOverview.astro';
import ClinicCapabilities from '../components/ClinicCapabilities.astro';
import Contact from '../components/Contact.astro';
import EngineeringIllustration from '../components/EngineeringIllustration.astro';
import { siteConfig } from '../config/site';

const featuredWork = await getCollection('work', (project) => project.data.featured);
---

<BaseLayout>
  <section class="hero container" aria-labelledby="hero-heading">
    <div class="hero-main">
      <p class="eyebrow hero-eyebrow"><span class="accent-square" aria-hidden="true"></span>Independent software development & consulting</p>
      <h1 id="hero-heading">Software that<br />moves your<br />business <span class="hero-final">forward<span class="accent-period">.</span></span></h1>
      <div class="hero-bottom">
        <p>From your first idea to the software<br class="desktop-break" /> your business runs on. I build the whole thing.</p>
        <a class="text-link" href="#work">Explore my work<Arrow /></a>
      </div>
    </div>
    <div class="hero-aside" role="group" aria-label="Software delivery and your engineer">
      <EngineeringIllustration />
      <div class="hero-profile">
        <div class="hero-person">
          <p class="person-name">{siteConfig.owner.name}</p>
          <p>{siteConfig.owner.role}</p>
        </div>
        <a class="button button-blue" href={siteConfig.contact.url}>{siteConfig.contact.label}<Arrow diagonal /></a>
      </div>
    </div>
  </section>

  <div class="capability-strip" aria-label="Development capabilities">
    <div class="container capability-strip-inner">
      <span>Web & applications</span><span class="strip-cross" aria-hidden="true">+</span>
      <span>Backend & APIs</span><span class="strip-cross" aria-hidden="true">+</span>
      <span>Automation</span><span class="strip-cross" aria-hidden="true">+</span>
      <span>Cloud & delivery</span>
    </div>
  </div>

  <section class="work-section section-pad container" id="work" aria-labelledby="work-heading">
    <div class="section-intro">
      <div><p class="eyebrow">Selected client work</p><h2 id="work-heading">Built for the<br /><span class="muted-heading">real world.</span></h2></div>
      <p>A closer look at how a business need<br class="desktop-break" /> becomes a working software system.</p>
    </div>
    {featuredWork.map((project) => (
      <article class:list={['featured-project', { 'orthopedic-project': project.id === 'orthopedic-spine' }]}>
        {project.id === 'orthopedic-spine' && <ClinicOverview />}
        <div class="project-copy">
          <p class="eyebrow">{project.data.category}</p>
          <h3><a href={`/work/${project.id}/`}>{project.data.title}</a></h3>
          <p class="project-summary">{project.data.summary}</p>
          {project.id === 'orthopedic-spine' ? <ClinicCapabilities capabilities={project.data.capabilities} /> : <ul class="project-capabilities" aria-label="Delivered capabilities">
            {project.data.capabilities.map((capability) => <li>{capability}</li>)}
          </ul>}
          <p class="stack-line">{project.data.stack.join(' / ')}</p>
          <a class:list={project.id === 'orthopedic-spine' ? ['button', 'button-blue', 'project-button'] : ['text-link']} href={`/work/${project.id}/`}>Inside the project<Arrow /></a>
        </div>
      </article>
    ))}
  </section>

  <section class="services-section section-pad" id="services" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-intro">
        <div><p class="eyebrow">How I can help</p><h2 id="services-heading">The right software.<br /><span class="muted-heading">For your next move.</span></h2></div>
        <p>One part of your system, or the full picture.<br class="desktop-break" /> From concept through deployment.</p>
      </div>
      <div class="service-list">
        {siteConfig.services.map((service) => (
          <article class="service-row">
            <div class="service-title"><span class="service-plus" aria-hidden="true">+</span><h3>{service.title}</h3></div>
            <div class="service-description"><p>{service.description}</p><p class="service-tools">{service.tools}</p></div>
            <ul>{service.capabilities.map((capability) => <li>{capability}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="about-section section-pad container" id="about" aria-labelledby="about-heading">
    <div class="about-heading"><p class="eyebrow">The person behind the work</p><h2 id="about-heading">Hello,<br />I’m Alonso<span class="accent-period">.</span></h2><p class="about-role">{siteConfig.owner.role}</p></div>
    <div class="about-copy">
      <p class="about-lead">Good software starts<br class="desktop-break" /> with understanding<br class="desktop-break" /> what matters.</p>
      <p>{siteConfig.owner.biography}</p>
      <p>I work across frontend, backend, automation, and infrastructure. That means I can connect the details of an interface with the systems behind it—and help you bring the pieces together.</p>
      <a class="text-link" href={siteConfig.contact.url}>More about me<Arrow diagonal /></a>
    </div>
  </section>

  <Contact />
</BaseLayout>
