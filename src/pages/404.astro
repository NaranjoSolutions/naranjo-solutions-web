---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout title={`Page not found — ${siteConfig.brand}`} noindex>
  <section class="not-found container" aria-labelledby="not-found-heading">
    <p class="eyebrow">404 / A small detour</p>
    <h1 id="not-found-heading">Let’s get you<br />back on track<span class="accent-period">.</span></h1>
    <p>This page couldn’t be found. Explore my work or head back to the homepage.</p>
    <div class="not-found-actions"><a class="button button-blue" href="/">Back to home<Arrow /></a><a class="text-link" href="/#work">See selected work<Arrow /></a></div>
  </section>
</BaseLayout>
