---
import { getLocalizedProjects } from '../content/projects';
import { localePath, type Locale } from '../i18n/locale';
import { translations } from '../i18n/translations';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from './Arrow.astro';
import ClinicOverview from './ClinicOverview.astro';
import ClinicCapabilities from './ClinicCapabilities.astro';
import Contact from './Contact.astro';
import EngineeringIllustration from './EngineeringIllustration.astro';
import { getSiteConfig } from '../config/site';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const siteConfig = getSiteConfig(locale);
const copy = translations[locale].home;
const projectCopy = translations[locale].project;
const featuredWork = (await getLocalizedProjects(locale)).filter((project) => project.data.featured);
---

<BaseLayout locale={locale}>
  <section class="hero container" aria-labelledby="hero-heading">
    <div class="hero-main">
      <p class="eyebrow hero-eyebrow"><span class="accent-square" aria-hidden="true"></span>{copy.eyebrow}</p>
      <h1 id="hero-heading">{copy.heading[0]}<br />{copy.heading[1]}<br />{copy.heading[2]} <span class="hero-final">{copy.headingFinal}<span class="accent-period">.</span></span></h1>
      <div class="hero-bottom">
        <p>{copy.intro[0]}<br class="desktop-break" /> {copy.intro[1]}</p>
        <a class="text-link" href="#work">{copy.explore}<Arrow /></a>
      </div>
    </div>
    <div class="hero-aside" role="group" aria-label={copy.delivery}>
      <EngineeringIllustration locale={locale} />
      <div class="hero-profile">
        <div class="hero-person">
          <p class="person-name">{siteConfig.owner.name}</p>
          <p>{siteConfig.owner.role}</p>
        </div>
        <a class="button button-blue" href={siteConfig.contact.url}>{siteConfig.contact.label}<Arrow diagonal /></a>
      </div>
    </div>
  </section>

  <div class="capability-strip" aria-label={copy.capabilities}>
    <div class="container capability-strip-inner">
      <span>{copy.strip[0]}</span><span class="strip-cross" aria-hidden="true">+</span>
      <span>{copy.strip[1]}</span><span class="strip-cross" aria-hidden="true">+</span>
      <span>{copy.strip[2]}</span><span class="strip-cross" aria-hidden="true">+</span>
      <span>{copy.strip[3]}</span>
    </div>
  </div>

  <section class="work-section section-pad container" id="work" aria-labelledby="work-heading">
    <div class="section-intro">
      <div><p class="eyebrow">{copy.workEyebrow}</p><h2 id="work-heading">{copy.workHeading[0]}<br /><span class="muted-heading">{copy.workHeading[1]}</span></h2></div>
      <p>{copy.workIntro[0]}<br class="desktop-break" /> {copy.workIntro[1]}</p>
    </div>
    {featuredWork.map((project) => (
      <article class:list={['featured-project', { 'orthopedic-project': project.data.projectId === 'orthopedic-spine' }]}>
        {project.data.projectId === 'orthopedic-spine' && <ClinicOverview locale={locale} />}
        <div class="project-copy">
          <p class="eyebrow">{project.data.category}</p>
          <h3><a href={localePath(`/work/${project.data.projectId}/`, locale)}>{project.data.title}</a></h3>
          <p class="project-summary">{project.data.summary}</p>
          {project.data.projectId === 'orthopedic-spine' ? <ClinicCapabilities locale={locale} capabilities={project.data.capabilities} /> : <ul class="project-capabilities" aria-label={projectCopy.capabilities}>
            {project.data.capabilities.map((capability) => <li>{capability.label}</li>)}
          </ul>}
          <p class="stack-line">{project.data.stack.join(' / ')}</p>
          <a class:list={project.data.projectId === 'orthopedic-spine' ? ['button', 'button-blue', 'project-button'] : ['text-link']} href={localePath(`/work/${project.data.projectId}/`, locale)}>{copy.inside}<Arrow /></a>
        </div>
      </article>
    ))}
  </section>

  <section class="services-section section-pad" id="services" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-intro">
        <div><p class="eyebrow">{copy.servicesEyebrow}</p><h2 id="services-heading">{copy.servicesHeading[0]}<br /><span class="muted-heading">{copy.servicesHeading[1]}</span></h2></div>
        <p>{copy.servicesIntro[0]}<br class="desktop-break" /> {copy.servicesIntro[1]}</p>
      </div>
      <div class="service-list">
        {siteConfig.services.map((service) => (
          <article class="service-row">
            <div class="service-title"><span class="service-plus" aria-hidden="true">+</span><h3>{service.title}</h3></div>
            <div class="service-description"><p>{service.description}</p><p class="service-tools">{service.tools}</p></div>
            <ul>{service.capabilities.map((capability) => <li>{capability}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="about-section section-pad container" id="about" aria-labelledby="about-heading">
    <div class="about-heading"><p class="eyebrow">{copy.aboutEyebrow}</p><h2 id="about-heading">{copy.greeting[0]}<br />{copy.greeting[1]}<span class="accent-period">.</span></h2><p class="about-role">{siteConfig.owner.role}</p></div>
    <div class="about-copy">
      <p class="about-lead">{copy.aboutLead[0]}<br class="desktop-break" /> {copy.aboutLead[1]}<br class="desktop-break" /> {copy.aboutLead[2]}</p>
      <p>{siteConfig.owner.biography}</p>
      <p>{copy.aboutBody}</p>
      <a class="text-link" href={siteConfig.contact.url}>{copy.more}<Arrow diagonal /></a>
    </div>
  </section>

  <Contact locale={locale} />
</BaseLayout>
