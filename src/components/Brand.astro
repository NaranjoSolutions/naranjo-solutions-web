---
import { siteConfig } from '../config/site';
import { localePath, type Locale } from '../i18n/locale';
import { translations } from '../i18n/translations';

interface Props {
  locale?: Locale;
  localizeError?: boolean;
}

const { locale = 'en', localizeError = false } = Astro.props;
---

<a class="brand" href={localePath('/', locale)} aria-label={`${siteConfig.brand} — ${translations[locale].layout.home}`} data-language-aria={localizeError ? 'layout.home' : undefined} data-language-link={localizeError ? '/' : undefined}>
  <img class="brand-mark" src="/favicon.svg" width="44" height="44" alt="" />
  <span>Naranjo<span class="brand-subtitle">Solutions</span></span>
</a>
