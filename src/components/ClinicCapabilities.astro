---
import ClinicIcon from './ClinicIcon.astro';
import type { Locale } from '../i18n/locale';
import { translations } from '../i18n/translations';

interface Props {
  locale: Locale;
  capabilities: { id: string; label: string }[];
}

const { locale, capabilities } = Astro.props;
const copy = translations[locale];
const capabilityIcons = { website: 'website', booking: 'booking', dashboard: 'dashboard', database: 'database' } as const;
---

<ul class="clinic-capabilities" aria-label={copy.project.capabilities}>
  {capabilities.map((capability) => {
    const capabilityId = capability.id as keyof typeof capabilityIcons;
    const description = copy.clinic.descriptions[capabilityId];
    return (
      <li>
        <span class="capability-icon"><ClinicIcon kind={capabilityIcons[capabilityId] ?? 'website'} /></span>
        <div><strong>{capability.label}</strong>{description && <p>{description}</p>}</div>
      </li>
    );
  })}
</ul>
