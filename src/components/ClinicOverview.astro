---
import { Image } from 'astro:assets';
import spineIllustration from '../assets/orthopedic-spine.png';
import ClinicIcon from './ClinicIcon.astro';
import '../styles/clinic.css';
import type { Locale } from '../i18n/locale';
import { translations } from '../i18n/translations';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = translations[locale].clinic;

const calendarDays = Array.from({ length: 35 }, (_, calendarIndex) => {
  const day = calendarIndex - 2;
  return day >= 1 && day <= 30 ? day : '';
});
const sampleAppointments = copy.appointments.map((reference, appointmentIndex) => ({
  reference, status: copy.statuses[appointmentIndex],
}));
---

<figure class="clinic-overview">
  <div class="clinic-art">
    <div class="clinic-art-heading">
      <span class="eyebrow">{copy.category}</span>
      <span class="diagram-label">{copy.overview}</span>
    </div>
    <div class="clinic-art-body">
      <div class="clinic-art-copy">
        <p class="clinic-art-title">Orthopedic<br />Spine</p>
        <p class="clinic-art-subtitle">{copy.subtitle}</p>
      </div>
      <div class="clinic-spine-scene" aria-hidden="true">
        <span class="spine-orbit spine-orbit-outer"></span>
        <span class="spine-orbit spine-orbit-inner"></span>
        <Image class="spine-illustration" src={spineIllustration} alt="" widths={[240, 480, 720]} sizes="(min-width: 640px) 400px, 240px" format="webp" quality={85} loading="lazy" />
        <span class="spine-callout"><span class="callout-dot"></span><strong>{copy.connected}</strong><span>{copy.connections}</span></span>
      </div>
    </div>

    <div class="clinic-previews">
      <div class="clinic-preview">
        <div class="interface-preview website-preview" aria-hidden="true">
          <div class="browser-bar"><i></i><i></i><i></i><span>orthopedic spine</span></div>
          <div class="website-preview-nav"><span>Orthopedic Spine</span><span>{copy.ourClinic}</span></div>
          <div class="website-preview-hero">
            <div><span class="preview-eyebrow">{copy.care}</span><strong>{copy.careHeading[0]}<br />{copy.careHeading[1]}</strong><span class="preview-copy-line"></span><span class="preview-copy-line preview-copy-short"></span><span class="preview-action">{copy.explore}</span></div>
            <Image src={spineIllustration} alt="" widths={[120, 240]} sizes="120px" format="webp" quality={80} loading="lazy" />
          </div>
        </div>
        <div class="preview-caption"><span class="preview-caption-icon"><ClinicIcon kind="website" /></span><div><p class="preview-title">{copy.publicWebsite}</p><p>{copy.publicCaption}</p></div></div>
      </div>

      <div class="clinic-preview">
        <div class="interface-preview booking-preview" aria-hidden="true">
          <strong>{copy.appointment}</strong>
          <div class="booking-preview-body">
            <div class="preview-calendar"><div class="calendar-heading"><span>‹</span><span>{copy.month}</span><span>›</span></div><div class="calendar-grid">{copy.weekdays.map((weekday) => <span class="calendar-weekday">{weekday}</span>)}{calendarDays.map((day) => <span class:list={{ 'calendar-selected': day === 14 }}>{day}</span>)}</div></div>
            <div class="preview-times"><span>09:00</span><span class="preview-time-selected">10:30</span><span>11:00</span><span>14:00</span></div>
          </div>
          <span class="booking-preview-note">{copy.bookingNote}</span>
        </div>
        <div class="preview-caption"><span class="preview-caption-icon"><ClinicIcon kind="booking" /></span><div><p class="preview-title">{copy.onlineBooking}</p><p>{copy.bookingCaption}</p></div></div>
      </div>

      <div class="clinic-preview">
        <div class="interface-preview dashboard-preview" aria-hidden="true">
          <div class="dashboard-preview-nav"><span class="dashboard-wordmark">OS</span><span class="dashboard-nav-active">{copy.navigation[0]}</span><span>{copy.navigation[1]}</span><span>{copy.navigation[2]}</span><span>{copy.navigation[3]}</span></div>
          <div class="dashboard-preview-main"><strong>{copy.clinicOverview}</strong><div class="dashboard-search">{copy.search}</div><div class="dashboard-table-heading"><span>{copy.reference}</span><span>{copy.status}</span></div>{sampleAppointments.map((appointment) => <div class="dashboard-table-row"><span>{appointment.reference}</span><span class="dashboard-status">{appointment.status}</span></div>)}<div class="dashboard-bars"><span></span><span></span><span></span><span></span><span></span><span></span></div></div>
        </div>
        <div class="preview-caption"><span class="preview-caption-icon"><ClinicIcon kind="dashboard" /></span><div><p class="preview-title">{copy.dashboard}</p><p>{copy.dashboardCaption}</p></div></div>
      </div>
    </div>
    <div class="clinic-backend"><span>{copy.backend}</span><strong>React / FastAPI / PostgreSQL</strong></div>
  </div>
  <figcaption>{copy.caption}</figcaption>
</figure>
