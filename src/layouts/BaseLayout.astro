---
import Brand from '../components/Brand.astro';
import Arrow from '../components/Arrow.astro';
import { siteConfig } from '../config/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = `${siteConfig.brand} — Software development & consulting`,
  description = siteConfig.description,
  noindex = false,
} = Astro.props;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const isHome = Astro.url.pathname === '/';
const navigation = [
  { label: 'Work', id: 'work' },
  { label: 'Services', id: 'services' },
  { label: 'About', id: 'about' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1426" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (() => {
        const storageKey = 'naranjo-theme';
        const deviceTheme = window.matchMedia('(prefers-color-scheme: dark)');
        let preference = 'system';

        try {
          const savedPreference = localStorage.getItem(storageKey);
          if (savedPreference === 'light' || savedPreference === 'dark') {
            preference = savedPreference;
          }
        } catch {
          // Storage can be blocked while the rest of the page remains usable.
        }

        const applyTheme = () => {
          const theme = preference === 'system' ? (deviceTheme.matches ? 'dark' : 'light') : preference;
          document.documentElement.dataset.theme = theme;
          document.querySelectorAll('meta[name="theme-color"]').forEach((metadata) => {
            metadata.content = theme === 'dark' ? '#0d1426' : '#ffffff';
          });
          const toggle = document.getElementById('theme-toggle');
          if (toggle) {
            const label = theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';
            toggle.setAttribute('aria-label', label);
            toggle.title = label;
          }
        };

        applyTheme();
        deviceTheme.addEventListener('change', () => {
          if (preference === 'system') applyTheme();
        });

        document.addEventListener('DOMContentLoaded', () => {
          const toggle = document.getElementById('theme-toggle');
          applyTheme();
          toggle.addEventListener('click', () => {
            preference = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
            applyTheme();
            try {
              localStorage.setItem(storageKey, preference);
            } catch {
              // Keep the selection active for this page when it cannot be saved.
            }
          });
          toggle.hidden = false;
        }, { once: true });
      })();
    </script>
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header container">
      <Brand />
      <nav class="site-nav" aria-label="Main navigation">
        {navigation.map((item) => (
          <a href={`${isHome ? '' : '/'}#${item.id}`}>{item.label}</a>
        ))}
        <a class="nav-contact" href={isHome ? '#contact' : '/#contact'}>Contact<Arrow diagonal /></a>
      </nav>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark mode" title="Switch to dark mode" hidden>
        <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79Z" />
        </svg>
        <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
        </svg>
      </button>
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="site-footer container">
      <Brand />
      <p>Independent engineering.<br />Built with purpose.</p>
      <div class="footer-credit"><span>© {new Date().getFullYear()} {siteConfig.brand}</span><span>By {siteConfig.owner.name}</span></div>
    </footer>
  </body>
</html>
